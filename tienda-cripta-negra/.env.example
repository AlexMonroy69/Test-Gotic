# Copia este archivo como .env para pruebas locales (o define estas variables en Render).

# Cadena de conexion a Postgres. SIN esto, la tienda guarda los productos en un
# archivo JSON local (data.json) -> perfecto para probar en tu maquina.
# En Render la obtienes al crear la base de datos Postgres (Internal Database URL).
DATABASE_URL=

# Credenciales del panel de administracion de productos.
ADMIN_USER=admin
ADMIN_PASS=cambia-esta-clave

# Clave para firmar el token de sesion del panel. Pon cualquier texto largo y aleatorio.
SESSION_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# Numero de WhatsApp al que llegan los pedidos (formato internacional, solo numeros).
# Ejemplo Colombia: 573001234567
WHATSAPP=573001234567
