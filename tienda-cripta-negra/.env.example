# Copia este archivo como .env para pruebas locales (o define estas variables en Render/Vercel).

# Cadena de conexion a Postgres. SIN esto, se usa un archivo JSON local (solo para pruebas).
# En Render: la obtienes al crear la base de datos Postgres (Internal/External Database URL).
# En Neon (para Vercel): la copias del dashboard de Neon.
DATABASE_URL=

# Credenciales del panel de administracion.
ADMIN_USER=pingonsito
ADMIN_PASS=pingonsita

# Clave para firmar el token de sesion del panel. Pon cualquier texto largo y aleatorio.
SESSION_SECRET=pon-aqui-un-texto-largo-y-aleatorio
